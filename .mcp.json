{
  "mcpServers": {
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp@latest"]
    },
    "memory": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "${STORYWEB_MEMORY_FILE:-E:/Dev/StoryWeb/.agents/memory/storyweb-memory.jsonl}"
      }
    }
  }
}

# Chỉ cần điền khi tích hợp cơ sở dữ liệu và các dịch vụ bên ngoài.
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_PANEL_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Mở khóa chương (M2). Admin bật/tắt và chọn phương thức ở /panel/cai-dat; env là chặn cứng + secret. ---
# true = tạm dừng mọi luồng mở khóa ngay lập tức (không cần sửa DB).
UNLOCK_EMERGENCY_OFF=false
# Ký cookie quyền đọc 5 phút (cả hai phương thức). Ít nhất 32 ký tự.
CLICK_UNLOCK_SECRET=
# Phương thức "Nhấp liên kết" chỉ được bật khi biến này là true.
CLICK_UNLOCK_ENABLED=false
# URL mặc định khi admin để trống ô URL. https + tên miền công khai bất kỳ (không IP/localhost/nội bộ);
# https://example.com/ dùng thử. Server không truy cập URL này; link rút gọn/redirect có thể dẫn tới đích khác.
CLICK_UNLOCK_URL=
# Chỉ link trực tiếp tới shopee.vn / shp.ee / shope.ee cần cờ này. Chỉ đặt true khi có chấp thuận riêng; không bật để test.
SHOPEE_GATE_APPROVED=false

# "Xem quảng cáo có thưởng": chỉ nhà cung cấp web có callback xác minh phía server. Hiện chỉ có "mock" (dev/test).
REWARDED_AD_PROVIDER=
# Chỉ dev/test: secret ký callback mock; production/Railway luôn từ chối mock.
REWARDED_MOCK_SECRET=
# Chỉ test e2e trên bản build local (next start): cho phép mock. Không đặt trên Railway.
STORYWEB_ALLOW_MOCK_REWARDED=

# --- Quảng cáo hiển thị (không cấp quyền đọc). adsense | mock (dev/test) ---
DISPLAY_AD_PROVIDER=
# ca-pub-XXXXXXXXXXXXXXXX và mã đơn vị (chỉ chữ số) cho từng vị trí.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_HOME_FEED=
ADSENSE_SLOT_STORY_DETAIL=
ADSENSE_SLOT_READER_END=
ADSENSE_SLOT_SEARCH_RESULTS=
STORYWEB_ALLOW_MOCK_ADS=
